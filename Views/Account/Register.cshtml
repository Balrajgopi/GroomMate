@model GroomMate.Models.User

@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="form-card p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-plus fs-2"></i>
                    </div>
                    <h2 class="playfair-font mb-1">Create Account</h2>
                    <p class="text-muted" style="font-size: 0.9rem;">Join GroomMate for a premium grooming experience</p>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger p-2", style = "font-size: 0.85rem;" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-bounding-box"></i></span>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-start-0 ps-0", placeholder = "Enter your full name" })
                        </div>
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger mt-1 d-block", style = "font-size: 0.8rem;" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Username, new { @class = "form-label text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control border-start-0 ps-0", placeholder = "Choose a username" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger mt-1 d-block", style = "font-size: 0.8rem;" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 ps-0", placeholder = "Enter email address", type = "email" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger mt-1 d-block", style = "font-size: 0.8rem;" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label text-dark" })
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 border-end-0 ps-0", id = "registerPasswordInput", placeholder = "Create a password" })
                            <button class="btn btn-outline-secondary border-start-0 bg-light text-muted" type="button" id="toggleRegPasswordBtn" onclick="togglePasswordVisibility('registerPasswordInput', 'toggleRegPasswordIcon')" title="Show/Hide Password">
                                <i class="bi bi-eye" id="toggleRegPasswordIcon"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger mt-1 d-block", style = "font-size: 0.8rem;" })
                    </div>

                    <button type="submit" class="btn btn-book-now w-100 py-2 mb-3">Register</button>

                    <div class="text-center mt-3">
                        <span class="text-muted" style="font-size: 0.85rem;">Already have an account?</span>
                        @Html.ActionLink("Log in here", "Login", "Account", null, new { @class = "text-warning fw-bold text-decoration-none ms-1", style = "font-size: 0.85rem;" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
