@model IEnumerable<GroomMate.Models.Service>
@using GroomMate.Models
@using System.Collections.Generic

@{
    ViewBag.Title = "Our Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var feedbackByService = ViewBag.FeedbackByService as Dictionary<int, List<Feedback>>;
}

<div class="container py-4">
    <div class="text-center mb-5">
        <span class="text-warning text-uppercase fw-bold letter-spacing-1 d-block mb-2">Treat Yourself</span>
        <h1 class="display-5 mb-3 playfair-font">Choose a Grooming Service</h1>
        <p class="text-muted col-md-6 mx-auto">Select one of our premium services below to schedule your appointment with our finest grooming professionals.</p>
        <div class="mx-auto bg-warning" style="width: 60px; height: 3px; border-radius: 2px;"></div>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var service in Model)
        {
            string iconClass = "bi-scissors";
            string nameLower = service.ServiceName.ToLower();
            if (nameLower.Contains("haircut") || nameLower.Contains("hair cut"))
            {
                iconClass = "bi-scissors";
            }
            else if (nameLower.Contains("beard") || nameLower.Contains("trim"))
            {
                iconClass = "bi-brush";
            }
            else if (nameLower.Contains("shave") || nameLower.Contains("shaving"))
            {
                iconClass = "bi-droplet-half";
            }
            else if (nameLower.Contains("spa") || nameLower.Contains("treatment") || nameLower.Contains("protein"))
            {
                iconClass = "bi-flower1";
            }
            else if (nameLower.Contains("facial") || nameLower.Contains("massage") || nameLower.Contains("cleanup") || nameLower.Contains("clean up"))
            {
                iconClass = "bi-emoji-smile";
            }
            else if (nameLower.Contains("color") || nameLower.Contains("colour") || nameLower.Contains("style"))
            {
                iconClass = "bi-palette2";
            }
            else if (nameLower.Contains("kids") || nameLower.Contains("child") || nameLower.Contains("children"))
            {
                iconClass = "bi-emoji-laughing";
            }
            else if (nameLower.Contains("combo") || nameLower.Contains("package") || nameLower.Contains("all"))
            {
                iconClass = "bi-gem";
            }
            else if (nameLower.Contains("wash"))
            {
                iconClass = "bi-droplet";
            }

            var serviceReviews = feedbackByService != null && feedbackByService.ContainsKey(service.ServiceID)
                ? feedbackByService[service.ServiceID]
                : new List<Feedback>();

            double avgRating = serviceReviews.Count > 0 ? serviceReviews.Average(f => f.Rating) : 0;

            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 service-card">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle" style="width: 50px; height: 50px;">
                                <i class="bi @iconClass fs-4"></i>
                            </div>
                            <span class="price-tag">&#8377; @service.Price.ToString("N0")</span>
                        </div>

                        <h5 class="card-title mb-2">@service.ServiceName</h5>
                        <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem; line-height: 1.6;">@service.Description</p>

                        @* Rating summary *@
                        @if (serviceReviews.Count > 0)
                        {
                            <div class="service-rating-bar d-flex align-items-center gap-2 mb-3">
                                <div class="d-flex">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= Math.Round(avgRating))
                                        {
                                            <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted" style="font-size: 0.85rem;"></i>
                                        }
                                    }
                                </div>
                                <span class="text-muted" style="font-size: 0.78rem;">@avgRating.ToString("0.0") (@serviceReviews.Count review@(serviceReviews.Count != 1 ? "s" : ""))</span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <span class="text-muted" style="font-size: 0.78rem;"><i class="bi bi-star me-1"></i>No reviews yet</span>
                            </div>
                        }

                        <hr class="my-2 opacity-10">

                        <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                            <span class="text-muted d-flex align-items-center" style="font-size: 0.8rem;">
                                <i class="bi bi-wallet2 me-1"></i> Cash at Salon
                            </span>
                            @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                            {
                                <span class="text-muted fst-italic" style="font-size: 0.8rem;"><i class="bi bi-info-circle me-1"></i>Staff View</span>
                            }
                            else
                            {
                                @Html.ActionLink("Book Now", "Create", "Appointment", new { serviceId = service.ServiceID }, new { @class = "btn btn-book-now btn-sm px-4" })
                            }
                        </div>

                        @* Customer Reviews Section *@
                        @if (serviceReviews.Count > 0)
                        {
                            <div class="reviews-section mt-3">
                                <p class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.72rem; letter-spacing: 0.5px;">Customer Reviews</p>
                                @foreach (var review in serviceReviews.Take(2))
                                {
                                    <div class="review-card p-2 mb-2 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fw-semibold text-dark" style="font-size: 0.82rem;">
                                                <i class="bi bi-person-circle text-warning me-1"></i>
                                                @(review.Appointment?.User?.FullName ?? "Customer")
                                            </span>
                                            <div class="d-flex">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    if (s <= review.Rating)
                                                    {
                                                        <i class="bi bi-star-fill text-warning" style="font-size: 0.7rem;"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-muted" style="font-size: 0.7rem;"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.Comments))
                                        {
                                            <p class="mb-0 text-muted" style="font-size: 0.8rem; line-height: 1.45;">"@review.Comments"</p>
                                        }
                                    </div>
                                }
                                @if (serviceReviews.Count > 2)
                                {
                                    <p class="text-muted mb-0" style="font-size: 0.75rem;"><i class="bi bi-chat-dots me-1"></i>+@(serviceReviews.Count - 2) more review@(serviceReviews.Count - 2 != 1 ? "s" : "")</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
