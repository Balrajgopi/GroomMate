@model IEnumerable<GroomMate.Models.Appointment>

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Admin Dashboard</h2>
<p>Manage all upcoming and past appointments.</p>

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Service</th>
            <th>Date & Time</th>
            <th>Assigned Staff</th>
            <th>Service Completion</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appt in Model)
        {
            <tr>
                <td>@appt.User.FullName</td>
                <td>@appt.Service.ServiceName</td>
                <td>@appt.AppointmentDate.ToString("g")</td>
                <td>
                    @* Logic to display staff dropdown or name *@
                    @if (appt.Status == "Pending")
                    {
                        using (Html.BeginForm("AssignStaff", "Admin", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("appointmentId", appt.AppointmentID)

                            @* Minimal fix: required + guarded onchange so we never submit empty staffId *@
                            @Html.DropDownList(
                                "staffId",
                                new SelectList((IEnumerable<SelectListItem>)ViewBag.StaffList, "Value", "Text", appt.StaffId),
                                "-- Select Staff --",
                                new
                                {
                                    @class = "form-select form-select-sm",
                                    required = "required",
                                    onchange = "if(this.value && this.value.length>0){ this.form.submit(); }"
                                }
                            )
                        }
                    }
                    else
                    {
                        @(appt.Staff?.FullName ?? "Not Assigned")
                    }
                </td>
                <td>
                    @if (appt.Status == "Completed")
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Completed by Staff</span>
                    }
                    else if (appt.Status == "Confirmed")
                    {
                        <span class="badge bg-primary"><i class="bi bi-clock-history me-1"></i> Service In Progress</span>
                    }
                    else if (appt.Status == "Cancelled")
                    {
                        <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Awaiting Staff</span>
                    }
                </td>
                <td><span class="badge bg-info text-dark">@appt.Status</span></td>
                <td>
                    @if (appt.Status == "Pending" && appt.StaffId.HasValue)
                    {
                        using (Html.BeginForm("ConfirmAppointment", "Admin", new { id = appt.AppointmentID }, FormMethod.Post, new { @style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm">Confirm</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h3 class="mt-5 mb-3">Customer Feedbacks</h3>
@if (ViewBag.Feedbacks == null || !((IEnumerable<GroomMate.Models.Feedback>)ViewBag.Feedbacks).Any())
{
    <div class="alert alert-info">
        No customer feedback has been submitted yet.
    </div>
}
else
{
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Customer ID</th>
                <th>Customer Name</th>
                <th>Service</th>
                <th>Appointment Date</th>
                <th>Rating</th>
                <th>Comments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fb in (IEnumerable<GroomMate.Models.Feedback>)ViewBag.Feedbacks)
            {
                <tr>
                    <td>@fb.Appointment.UserID</td>
                    <td>@fb.Appointment.User.FullName</td>
                    <td>@fb.Appointment.Service.ServiceName</td>
                    <td>@fb.Appointment.AppointmentDate.ToString("g")</td>
                    <td>
                        <span class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= fb.Rating)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </span>
                    </td>
                    <td>@fb.Comments</td>
                </tr>
            }
        </tbody>
    </table>
}
