@model IEnumerable<GroomMate.Models.Appointment>

@{
    ViewBag.Title = "My Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-md-row flex-column justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="playfair-font mb-1">My Dashboard</h2>
            <p class="text-muted mb-0">Track your current status, booking history, and manage appointments in one place.</p>
        </div>
        <div>
            @Html.ActionLink("Book New Appointment", "Index", "Service", null, new { @class = "btn btn-book-now px-4" })
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state mt-4">
            <i class="bi bi-calendar-x empty-state-icon"></i>
            <h3 class="playfair-font mb-2">No Grooming Sessions Found</h3>
            <p class="text-muted mb-4 col-md-6 mx-auto">You don't have any appointments booked yet. Choose one of our premium services and lock in your session today.</p>
            @Html.ActionLink("Book Appointment Now", "Index", "Service", null, new { @class = "btn btn-book-now px-4" })
        </div>
    }
    else
    {
        <div class="table-responsive table-responsive-container">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Service</th>
                        <th>Date & Time</th>
                        <th>Assigned Staff</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@appt.Service.ServiceName</div>
                                <div class="text-muted" style="font-size: 0.8rem;">₹ @appt.Service.Price.ToString("N0")</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar3 me-2 text-warning"></i>
                                    <span>@appt.AppointmentDate.ToString("g")</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person me-2 text-muted"></i>
                                    <span>@(appt.Staff?.FullName ?? "Pending Assignment")</span>
                                </div>
                            </td>
                            <td>
                                @if (appt.Status == "Completed")
                                {
                                    <span class="badge badge-completed"><i class="bi bi-patch-check-fill me-1"></i> Completed</span>
                                }
                                else if (appt.Status == "Confirmed")
                                {
                                    <span class="badge badge-confirmed"><i class="bi bi-check-circle-fill me-1"></i> Confirmed</span>
                                }
                                else if (appt.Status == "Cancelled")
                                {
                                    <span class="badge badge-cancelled"><i class="bi bi-x-circle-fill me-1"></i> Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge badge-pending"><i class="bi bi-hourglass-split me-1"></i> @appt.Status</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (appt.Status == "Completed" && appt.Feedback == null)
                                {
                                    @Html.ActionLink("Leave Feedback", "Submit", "Feedback", new { appointmentId = appt.AppointmentID }, new { @class = "btn btn-outline-primary btn-sm" })
                                }
                                else if (appt.Feedback != null)
                                {
                                    <span class="text-muted fst-italic" style="font-size: 0.85rem;"><i class="bi bi-star-fill text-warning me-1"></i> Feedback Sent</span>
                                }
                                else if (appt.Status == "Pending" || appt.Status == "Confirmed")
                                {
                                    using (Html.BeginForm("Cancel", "Appointment", new { id = appt.AppointmentID }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.85rem;">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
