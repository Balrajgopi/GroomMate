@model GroomMate.Models.Appointment

@{
    ViewBag.Title = "Book Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="mb-4">
                <a href="@Url.Action("Index", "Service")" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
                    <i class="bi bi-arrow-left me-1"></i> Back to Services
                </a>
            </div>

            <div class="row g-4">
                <!-- Left: Booking Form -->
                <div class="col-md-7">
                    <div class="form-card">
                        <span class="text-warning text-uppercase fw-bold letter-spacing-1 d-block mb-1" style="font-size: 0.8rem;">Secure Your Spot</span>
                        <h2 class="playfair-font mb-4">Book Appointment</h2>
                        
                        <div class="bg-light p-3 rounded-3 mb-4 border-start border-warning border-3">
                            <span class="text-muted d-block" style="font-size: 0.8rem; text-transform: uppercase;">Selected Service</span>
                            <span class="fw-bold fs-5 text-dark">@ViewBag.ServiceName</span>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            @Html.HiddenFor(model => model.ServiceID)

                            <div class="mb-4">
                                @Html.LabelFor(model => model.AppointmentDate, "Select Date & Time", new { @class = "form-label text-dark" })
                                @Html.EditorFor(model => model.AppointmentDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local", required = "required" } })
                                @Html.ValidationMessageFor(model => model.AppointmentDate, "", new { @class = "text-danger mt-1 d-block", style = "font-size: 0.85rem;" })
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-book-now px-4 py-2">Confirm Booking</button>
                                <a href="@Url.Action("Index", "Service")" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right: Salon Hours Sidebar -->
                <div class="col-md-5">
                    <div class="hours-widget">
                        <h4 class="playfair-font d-flex align-items-center">
                            <i class="bi bi-clock me-2 text-warning"></i> Salon Business Hours
                        </h4>
                        <p class="text-muted mb-4" style="font-size: 0.85rem; line-height: 1.5;">Please schedule your appointment within our business hours. The salon is closed on Tuesdays.</p>
                        
                        <div class="hours-row">
                            <span>Monday</span>
                            <span>9:00 AM - 10:00 PM</span>
                        </div>
                        <div class="hours-row closed">
                            <span>Tuesday</span>
                            <span>Closed (Weekly Off)</span>
                        </div>
                        <div class="hours-row">
                            <span>Wednesday</span>
                            <span>9:00 AM - 10:00 PM</span>
                        </div>
                        <div class="hours-row">
                            <span>Thursday</span>
                            <span>9:00 AM - 10:00 PM</span>
                        </div>
                        <div class="hours-row">
                            <span>Friday</span>
                            <span>9:00 AM - 10:00 PM</span>
                        </div>
                        <div class="hours-row">
                            <span>Saturday</span>
                            <span>8:00 AM - 9:00 PM</span>
                        </div>
                        <div class="hours-row">
                            <span>Sunday</span>
                            <span>10:00 AM - 6:00 PM</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
