                       onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#f8f9fa';">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 text-white" style="width: 36px; height: 36px; background: #0077b5;">
                            <i class="bi bi-linkedin" style="font-size: 1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-dark" style="font-size: 0.85rem;">LinkedIn Profile</div>
                            <div class="text-muted" style="font-size: 0.78rem;">linkedin.com/in/balraj-gopi</div>
                        </div>
                        <i class="bi bi-arrow-up-right-circle ms-auto text-muted"></i>
                    </a>

                    <a href="mailto:Balrajgopi0000@gmail.com"
                       class="d-flex align-items-center gap-3 p-3 rounded-3 text-decoration-none"
                       style="background: #f8f9fa; border: 1px solid #e2e8f0; transition: all 0.2s ease;"
                       onmouseover="this.style.borderColor='#ea4335'; this.style.background='#fff5f5';"
                       onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#f8f9fa';">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 text-white" style="width: 36px; height: 36px; background: #ea4335;">
                            <i class="bi bi-envelope-fill" style="font-size: 1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-dark" style="font-size: 0.85rem;">Gmail</div>
                            <div class="text-muted" style="font-size: 0.78rem;">Balrajgopi0000@gmail.com</div>
                        </div>
                        <i class="bi bi-arrow-up-right-circle ms-auto text-muted"></i>
                    </a>

                    <a href="mailto:balrajgopi2005@outlook.com"
                       class="d-flex align-items-center gap-3 p-3 rounded-3 text-decoration-none"
                       style="background: #f8f9fa; border: 1px solid #e2e8f0; transition: all 0.2s ease;"
                       onmouseover="this.style.borderColor='#0078d4'; this.style.background='#f0f4ff';"
                       onmouseout="this.style.borderColor='#e2e8f0'; this.style.background='#f8f9fa';">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 text-white" style="width: 36px; height: 36px; background: #0078d4;">
                            <i class="bi bi-microsoft" style="font-size: 1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-dark" style="font-size: 0.85rem;">Outlook</div>
                            <div class="text-muted" style="font-size: 0.78rem;">balrajgopi2005@outlook.com</div>
                        </div>
                        <i class="bi bi-arrow-up-right-circle ms-auto text-muted"></i>
                    </a>
                </div>


                <div class="text-center pt-2 border-top">
                    <p class="text-muted mb-3" style="font-size: 0.85rem;">Want to collaborate or have questions about the project?</p>
                    <a href="https://github.com/Balrajgopi/GroomMate" target="_blank" class="btn btn-dark rounded-pill px-4 me-2">
                        <i class="bi bi-github me-2"></i>Star on GitHub
                    </a>
                    <a href="mailto:Balrajgopi0000@gmail.com" class="btn btn-outline-warning rounded-pill px-4">
                        <i class="bi bi-envelope me-2"></i>Get in Touch
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

