<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GroomMate</title>
    @Styles.Render("~/Content/css")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="~/Content/Site-Custom.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark fixed-top navbar-groommate">
        <div class="container">
            <a href="@Url.Action("Index", "Home")" class="navbar-brand d-flex align-items-center">
                <i class="bi bi-scissors me-2 text-warning fs-4"></i>
                <span class="brand-text">GroomMate</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto mb-2 mb-md-0">
                    <li class="nav-item">@Html.ActionLink("About", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contact", "Contact", "Home", null, new { @class = "nav-link" })</li>
                </ul>

                <ul class="navbar-nav align-items-center">
                    @{
                        bool isLoggedIn = User.Identity.IsAuthenticated || Session["Username"] != null;
                        string pageTitle = ViewBag.Title as string ?? "";
                        bool isAuthPage = pageTitle.Contains("Log in") || pageTitle.Contains("Register") || pageTitle.Contains("Welcome Back") || pageTitle.Contains("Create Account");
                        
                        // Show "Book Now" in navbar ONLY for anonymous visitors who are NOT on Login or Register pages
                        bool showNavbarBookNow = !isLoggedIn && !isAuthPage;
                    }

                    @if (showNavbarBookNow)
                    {
                        <li class="nav-item me-2">
                            @Html.ActionLink("Book Now", "Index", "Service", null, new { @class = "btn btn-book-now" })
                        </li>
                    }

                    @if (isLoggedIn)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> Hello @(Session["Username"] ?? User.Identity.Name)!
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                @if (User.IsInRole("Admin") || (Session["Role"] as string) == "Admin")
                                {
                                    <li>@Html.ActionLink("Admin Dashboard", "AdminDashboard", "Dashboard", null, new { @class = "dropdown-item" })</li>
                                }
                                else if (User.IsInRole("Staff") || (Session["Role"] as string) == "Staff")
                                {
                                    <li>@Html.ActionLink("Staff Dashboard", "StaffDashboard", "Dashboard", null, new { @class = "dropdown-item" })</li>
                                }
                                else
                                {
                                    <li>@Html.ActionLink("My Dashboard", "CustomerDashboard", "Dashboard", null, new { @class = "dropdown-item" })</li>
                                }
                                <li>@Html.ActionLink("Switch Account", "SwitchAccount", "Account", null, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", @class = "m-0" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item btn btn-link text-decoration-none">
                                            <i class="bi bi-box-arrow-right me-2 text-danger"></i>Logout
                                        </button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("Register", "Register", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Log in", "Login", "Account", null, new { @class = "nav-link" })</li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        
        <footer class="footer-groommate mt-auto">
            <div class="footer-content text-center py-4 mt-5 border-top">
                <div class="d-flex justify-content-center align-items-center mb-2">
                    <i class="bi bi-scissors me-2 text-warning"></i>
                    <span class="playfair-font fw-bold text-white fs-5">GroomMate</span>
                </div>
                <p class="mb-1 text-muted">&copy; @DateTime.Now.Year - Premium Men's Grooming Platform</p>
                <!-- <div class="social-links d-flex justify-content-center gap-3 mt-2">
                    <span class="text-muted"><i class="bi bi-instagram"></i></span>
                    <span class="text-muted"><i class="bi bi-facebook"></i></span>
                    <span class="text-muted"><i class="bi bi-twitter"></i></span>
                </div> -->
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
